# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: create a project, then run supabase/schema.sql in its SQL Editor.
# The service role key is SERVER-ONLY. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: verify a sending domain before using it in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=aashay.rishuraj2903@gmail.com
CONTACT_FROM_EMAIL=

# Optional server-side token; public GitHub API requests work without it.
GITHUB_TOKEN=
